{
  "name": "@local/dsh-harness-enhanced",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Expand sessions, simplify the sidebar, recover unsent text, compact context by route, and auto-allow live models for subagents.",
  "exports": {
    ".": "./index.js",
    "./compaction": "./compaction-backend.js",
    "./compaction/locale/*.json": "./locale/compaction/*.json",
    "./compaction/icon": "./icon.svg",
    "./subagent-models": "./subagent-models-host.js",
    "./subagent-models/locale/*.json": "./locale/subagent-models/*.json",
    "./subagent-models/icon": "./icon.svg",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "failed-message.js", "failure-proof.js", "directory-link-host.js", "local-link-path.js", "subagent-models-host.js", "client.js", "compaction-backend.js", "compaction.js", "compaction-policy.js", "cordis.patch.yml", "locale/**/*.json", "icon.svg", "README.md"],
  "scripts": { "build": "node build.mjs", "test": "node build.mjs --check && node --test" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
